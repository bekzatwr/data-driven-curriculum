# Copy to deploy/.env. Pass it explicitly: --env-file deploy/.env
APP_TARGET=fullstack
FRONTEND_DIR=web
IMAGE_TAG=local
HOST_PORT=8080
DATABASE_PATH=/app/data/curriculum.sqlite3
# Keep true for a release. false is ONLY for isolated infrastructure tests.
REQUIRE_P0=true
# false permits the full CSV demo. Use synthetic fixtures only, with team approval.
READ_ONLY_DEMO=true
# Same origin frontend uses /api; no cross-origin permissions are needed.
CORS_ORIGINS=

# P1: ИИ-пояснения (бесплатные ключи; только на сервере, не коммитить значения)
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_PROVIDERS=groq,gemini
