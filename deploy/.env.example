# Copy to deploy/.env. Pass it explicitly: --env-file deploy/.env
APP_TARGET=fullstack
FRONTEND_DIR=web
IMAGE_TAG=local
HOST_PORT=8080
DATABASE_PATH=/app/data/curriculum.sqlite3
# Keep true for a release. false is ONLY for isolated infrastructure tests.
REQUIRE_P0=true
READ_ONLY_DEMO=true
# Refuse startup if public hosting is accidentally configured to allow writes.
PUBLIC_DEMO=true
# Same origin frontend uses /api; no cross-origin permissions are needed.
CORS_ORIGINS=

# P1: disabled provider access until the owner verifies account/model and budget.
P1_COMMENTS_ENABLED=true
TRUSTED_PROXY_CIDRS=
AI_ENABLED=false
AI_ACCOUNT_VERIFIED=false
AI_PROVIDERS=groq,gemini
# Runtime secrets only; never use VITE_ prefixes or Docker build arguments.
GROQ_API_KEY=
GEMINI_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
