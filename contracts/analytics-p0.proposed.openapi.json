{
  "openapi": "3.1.0",
  "info": {
    "title": "P0 analytics integration proposal — Toni review required",
    "version": "0.1.0-proposed",
    "description": "Design contract only. NOT a running API. Paths and TopicMetrics follow the hackathon TZ; response envelopes/status enum require Toni's review."
  },
  "x-owner": "Toni",
  "x-implementation-status": "not-published",
  "paths": {
    "/api/datasets/{dataset_id}/overview": {
      "get": {
        "operationId": "proposedOverview",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "class_ids",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            }
          },
          {
            "name": "textbook_ids",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            }
          },
          {
            "name": "test_version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposed success response; route is NOT implemented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "404": {
            "description": "Dataset/topic not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid filters or overlapping students",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/{dataset_id}/topics/{topic_id}": {
      "get": {
        "operationId": "proposedTopicDetails",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "class_ids",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            }
          },
          {
            "name": "textbook_ids",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            }
          },
          {
            "name": "test_version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposed success response; route is NOT implemented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicDetail"
                }
              }
            }
          },
          "404": {
            "description": "Dataset/topic not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid filters or overlapping students",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets/{dataset_id}/comparison": {
      "get": {
        "operationId": "proposedTextbookComparison",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "class_ids",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            }
          },
          {
            "name": "test_version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "topic_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "textbook_a",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "textbook_b",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposed success response; route is NOT implemented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comparison"
                }
              }
            }
          },
          "404": {
            "description": "Dataset/topic not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid filters or overlapping students",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TopicMetrics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "test_version",
          "max_score",
          "mean_post_pct",
          "below_threshold_share",
          "n_post",
          "n_pairs",
          "mean_pre_paired_pct",
          "mean_post_paired_pct",
          "mean_gain_pp",
          "status",
          "problem_topic",
          "warnings"
        ],
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "test_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_post_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "below_threshold_share": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "n_post": {
            "type": "integer",
            "minimum": 0
          },
          "n_pairs": {
            "type": "integer",
            "minimum": 0
          },
          "mean_pre_paired_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_post_paired_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_gain_pp": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "insufficient_data",
              "mixed_versions",
              "no_data"
            ]
          },
          "problem_topic": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BookGroup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "textbook_id",
          "n_pairs",
          "mean_pre_paired_pct",
          "mean_post_paired_pct",
          "mean_gain_pp"
        ],
        "properties": {
          "textbook_id": {
            "type": "string"
          },
          "n_pairs": {
            "type": "integer",
            "minimum": 0
          },
          "mean_pre_paired_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_post_paired_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_gain_pp": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "Overview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "topics",
          "warnings"
        ],
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicMetrics"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TopicDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "metrics",
          "by_class"
        ],
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "metrics": {
            "$ref": "#/components/schemas/TopicMetrics"
          },
          "by_class": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class_id",
                "metrics"
              ],
              "properties": {
                "class_id": {
                  "type": "string"
                },
                "metrics": {
                  "$ref": "#/components/schemas/TopicMetrics"
                }
              }
            }
          }
        }
      },
      "Comparison": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "topic_id",
          "test_version",
          "status",
          "group_a",
          "group_b",
          "baseline_gap_pp",
          "gain_difference_pp",
          "reasons",
          "warnings"
        ],
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "topic_id": {
            "type": "string"
          },
          "test_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "comparable",
              "not_comparable"
            ]
          },
          "group_a": {
            "$ref": "#/components/schemas/BookGroup"
          },
          "group_b": {
            "$ref": "#/components/schemas/BookGroup"
          },
          "baseline_gap_pp": {
            "type": [
              "number",
              "null"
            ]
          },
          "gain_difference_pp": {
            "type": [
              "number",
              "null"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "details",
          "total_errors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total_errors": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
